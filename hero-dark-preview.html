8次复奏_20260923.mp4","poster":"media/posters/CP05__CP05_Easy_中央单棒_8次复奏_20260923.jpg","duration_seconds":63.125},{"kind":"video","label":"Medium · 双臂揭罩流程","path":"media/videos/CP05__CP05_Medium_双臂揭罩_8次复奏_20260923.mp4","poster":"media/posters/CP05__CP05_Medium_双臂揭罩_8次复奏_20260923.jpg","duration_seconds":96.833333},{"kind":"video","label":"Hard · 揭罩与音量调节流程","path":"media/videos/CP05__CP05_Hard_揭罩与音量调节_12次复奏_20260923.mp4","poster":"media/posters/CP05__CP05_Hard_揭罩与音量调节_12次复奏_20260923.jpg","duration_seconds":128.833333}],"evidence":{"high":"保持琴键序列与重复次数，组织揭罩、Hard 音量调节、取棒、示范与复奏阶段","low":"双臂揭罩、同步取放、棒头准确触键与释放；Hard 完成音量推杆夹持调节","feedback":"准备状态满足后才启动示范，有效触键才推进序列；复奏结束仍需实际归棒和撤离"},"source_revision":903}]</script>
<script>
'use strict';
// Tables are pre-rendered so the candidate roster remains readable offline.
const lbPanels = [...document.querySelectorAll('[data-lb-panel]')];
const lbButtons = [...document.querySelectorAll('[data-lb-track]')];
let lbTrack = 'vla';
function updateLeaderboard() {
  const view = document.getElementById('leaderboardView').value;
  const query = document.getElementById('leaderboardSearch').value.trim().toLocaleLowerCase();
  let count = 0;
  for (const panel of lbPanels) {
    const active = panel.dataset.track === lbTrack && panel.dataset.view === view;
    panel.hidden = !active;
    for (const row of panel.querySelectorAll('[data-lb-row]')) {
      row.hidden = !row.dataset.name.includes(query);
      if (active && !row.hidden) count++;
    }
  }
  lbButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.lbTrack === lbTrack)));
  document.getElementById('leaderboardStatus').textContent = (lbTrack === 'vla' ? 'VLA / WAM' : 'Coding Agent') + ' · ' + count + ' 个候选 · 全部待评测 · 不按性能排序';
  document.getElementById('leaderboardEmpty').hidden = count !== 0;
}
lbButtons.forEach(button => button.addEventListener('click', () => { lbTrack = button.dataset.lbTrack; updateLeaderboard(); }));
document.getElementById('leaderboardView').addEventListener('change', updateLeaderboard);
document.getElementById('leaderboardSearch').addEventListener('input', updateLeaderboard);
window.addEventListener('beforeprint', () => lbPanels.forEach(panel => panel.hidden = false));
window.addEventListener('afterprint', updateLeaderboard);
document.querySelector('.lb-download').addEventListener('click', event => {
  event.preventDefault();
  const data = JSON.parse(document.getElementById('leaderboardData').textContent);
  const url = URL.createObjectURL(new Blob([JSON.stringify(data, null, 2)], {type:'application/json;charset=utf-8'}));
  const link = document.createElement('a');
  link.href = url; link.download = 'leaderboard.json'; link.click();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
});
updateLeaderboard();

const tocLinks=[...document.querySelectorAll('.article-nav a')];
const motionPreference=matchMedia('(prefers-reduced-motion: reduce)');
function syncMotionPreference(){document.documentElement.style.scrollBehavior=motionPreference.matches?'auto':'';}
syncMotionPreference();motionPreference.addEventListener('change',syncMotionPreference);
const tocObserver=new IntersectionObserver(entries=>{const visible=entries.filter(e=>e.isIntersecting).sort((a,b)=>a.boundingClientRect.top-b.boundingClientRect.top);if(!visible.length)return;const id='#'+visible[0].target.id;tocLinks.forEach(a=>{if(a.getAttribute('href')===id)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current');});},{rootMargin:'-10% 0px -65% 0px'});
tocLinks.forEach(a=>{const el=document.querySelector(a.getAttribute('href'));if(el)tocObserver.observe(el);});

const records=JSON.parse(document.getElementById('showcaseData').textContent), cards=[...document.querySelectorAll('.case-card')], search=document.getElementById('caseSearch');
const index=new Map(records.map(c=>[c.id,JSON.stringify(c).toLocaleLowerCase()]));let suite='all';
function applyFilters(){const q=search.value.trim().toLocaleLowerCase();const exactId=records.some(r=>r.id.toLocaleLowerCase()===q)?q:null;let n=0;cards.forEach(c=>{const show=(suite==='all'||c.dataset.suite===suite)&&(!q||(exactId?c.dataset.id.toLocaleLowerCase()===exactId:index.get(c.dataset.id).includes(q)));c.hidden=!show;if(show)n++;else c.querySelectorAll('video').forEach(v=>v.pause());});document.getElementById('resultCount').textContent=n+' / '+records.length+' 项任务';document.getElementById('emptyResult').hidden=n!==0;document.querySelectorAll('.filters button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.suite===suite)));}
function reset(){suite='all';search.value='';applyFilters();}
document.querySelectorAll('.filters button').forEach(b=>b.addEventListener('click',()=>{suite=b.dataset.suite;applyFilters();}));search.addEventListener('input',applyFilters);document.getElementById('resetFilters').addEventListener('click',reset);
document.getElementById('expandAll').addEventListener('click',()=>cards.filter(c=>!c.hidden).forEach(c=>c.open=true));document.getElementById('collapseAll').addEventListener('click',()=>cards.forEach(c=>{c.open=false;c.querySelectorAll('video').forEach(v=>v.pause());}));
function closeMenu(){document.getElementById('siteNav').classList.remove('open');document.getElementById('menuToggle').setAttribute('aria-expanded','false');}
function openHash(){let id;try{id=decodeURIComponent(location.hash.slice(1));}catch{return;}if(!id.startsWith('case-'))return;const card=document.getElementById(id);if(!card||!card.classList.contains('case-card'))return;if(card.hidden)reset();card.open=true;closeMenu();requestAnimationFrame(()=>card.scrollIntoView({block:'start'}));}
