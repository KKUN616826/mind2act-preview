const heroTrack=document.querySelector('.hero-track');
const heroDots=[...document.querySelectorAll('[data-hero-dot]')];
let heroPosition=1,heroLogical=0,heroBusy=false,heroTimer;
if(heroTrack){
  const originals=[...heroTrack.children];
  const lastClone=originals[originals.length-1].cloneNode(true);
  const firstClone=originals[0].cloneNode(true);
  [lastClone,firstClone].forEach(clone=>{
    clone.setAttribute('aria-hidden','true');
    clone.querySelectorAll('[id]').forEach(node=>node.removeAttribute('id'));
    clone.querySelectorAll('a,button,video').forEach(node=>node.setAttribute('tabindex','-1'));
  });
  heroTrack.prepend(lastClone);
  heroTrack.append(firstClone);
  const heroSlides=[...heroTrack.children];
  function heroTranslate(animate=true){
    heroTrack.style.transition=animate&&!motionPreference.matches?'transform .65s cubic-bezier(.16,1,.3,1)':'none';
    const gap=parseFloat(getComputedStyle(heroTrack).columnGap)||0;
    const step=heroSlides[0].offsetWidth+gap;heroTrack.style.transform=`translate3d(${-heroPosition*step}px,0,0)`;
    heroDots.forEach((dot,i)=>{const active=i===heroLogical;dot.classList.toggle('active',active);dot.setAttribute('aria-current',active?'true':'false');});
    heroSlides.forEach((slide,i)=>{slide.classList.toggle('is-centered',i===heroPosition);slide.inert=i!==heroPosition;});
    const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;
    heroSlides.forEach((slide,i)=>slide.querySelectorAll('video').forEach(v=>{if(!reduced&&!document.hidden&&i===heroPosition)v.play().catch(()=>{});else v.pause();}));
  }
  function heroSettle(){if(heroPosition===0)heroPosition=originals.length;if(heroPosition===originals.length+1)heroPosition=1;heroTranslate(false);heroBusy=false;}
  function heroMove(delta){if(heroBusy)return;heroBusy=true;heroPosition+=delta;heroLogical=(heroLogical+delta+originals.length)%originals.length;heroTranslate(true);if(matchMedia('(prefers-reduced-motion: reduce)').matches)heroSettle();}
  heroTrack.addEventListener('transitionend',e=>{if(e.target===heroTrack&&e.propertyName==='transform')heroSettle();});
  function restartHero(){clearInterval(heroTimer);if(!document.hidden&&!document.querySelector('.hero-carousel').matches(':hover')&&!document.querySelector('.hero-carousel').contains(document.activeElement)&&!matchMedia('(prefers-reduced-motion: reduce)').matches)heroTimer=setInterval(()=>heroMove(1),6500);}
  document.querySelector('.hero-prev')?.addEventListener('click',()=>{heroMove(-1);restartHero();});
  document.querySelector('.hero-next')?.addEventListener('click',()=>{heroMove(1);restartHero();});
  heroDots.forEach((dot,i)=>dot.addEventListener('click',()=>{if(i===heroLogical||heroBusy)return;heroMove(i-heroLogical);restartHero();}));
  const heroRoot=document.querySelector('.hero-carousel');heroRoot.addEventListener('mouseenter',()=>clearInterval(heroTimer));heroRoot.addEventListener('mouseleave',restartHero);heroRoot.addEventListener('focusin',()=>clearInterval(heroTimer));heroRoot.addEventListener('focusout',()=>requestAnimationFrame(restartHero));
  document.addEventListener('visibilitychange',()=>{heroTranslate(false);restartHero();});motionPreference.addEventListener('change',()=>{heroSettle();restartHero();});
  heroTranslate(false);window.addEventListener('resize',heroSettle);restartHero();
}


const marqueeTrack=document.querySelector('.marquee-track');
const reduceMotion=motionPreference.matches;
const taskVideos=[...document.querySelectorAll('.task-marquee video')];
if('IntersectionObserver' in window){
  const taskVideoObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{
    const video=entry.target;
    if(!motionPreference.matches&&!document.hidden&&entry.isIntersecting&&entry.intersectionRatio>.15)video.play().catch(()=>{});else video.pause();
  }),{threshold:[0,.15,.5]});
  taskVideos.forEach(video=>taskVideoObserver.observe(video));
}else if(!reduceMotion)taskVideos.forEach(video=>video.play().catch(()=>{}));
function syncTaskVideoPlayback(){taskVideos.forEach(video=>{const rect=video.getBoundingClientRect();if(!motionPreference.matches&&!document.hidden&&rect.bottom>0&&rect.top<innerHeight&&rect.right>0&&rect.left<innerWidth)video.play().catch(()=>{});else video.pause();});}
document.addEventListener('visibilitychange',syncTaskVideoPlayback);motionPreference.addEventListener('change',syncTaskVideoPlayback);syncTaskVideoPlayback();
if(marqueeTrack){
  let marqueeOffset=0,marqueeLast=performance.now(),marqueePaused=false;
  const marqueeGap=12,marqueeSpeed=42;
  marqueeTrack.closest('.task-marquee')?.addEventListener('mouseenter',()=>marqueePaused=true);
  marqueeTrack.closest('.task-marquee')?.addEventListener('mouseleave',()=>{marqueePaused=false;marqueeLast=performance.now();});
  marqueeTrack.closest('.task-marquee')?.addEventListener('focusin',()=>marqueePaused=true);
  marqueeTrack.closest('.task-marquee')?.addEventListener('focusout',()=>requestAnimationFrame(()=>{marqueePaused=marqueeTrack.closest('.task-marquee').contains(document.activeElement);marqueeLast=performance.now();}));
  function advanceMarquee(now){
    const elapsed=Math.min((now-marqueeLast)/1000,.05);marqueeLast=now;
    if(!marqueePaused&&!motionPreference.matches&&!document.hidden){
      marqueeOffset+=marqueeSpeed*elapsed;
      const first=marqueeTrack.firstElementChild;
      if(first&&marqueeOffset>=first.getBoundingClientRect().width+marqueeGap){
        marqueeOffset-=first.getBoundingClientRect().width+marqueeGap;
        marqueeTrack.appendChild(first);
      }
      marqueeTrack.style.transform=`translate3d(${-marqueeOffset}px,0,0)`;
    }
    requestAnimationFrame(advanceMarquee);
  }
  requestAnimationFrame(advanceMarquee);
}

